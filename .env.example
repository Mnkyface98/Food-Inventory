# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.

# Required for the analysis step (image review, style/authenticity reasoning, value estimate).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for the eBay source. Create an app at https://developer.ebay.com/my/keys
# Use "Production" keys once you're past sandbox testing.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: restrict eBay search to a category ID (e.g. 550 = Art).
# Leave blank to search by keyword only.
EBAY_CATEGORY_ID=550

# ShopGoodwill and EstateSales.net do not require API keys for the endpoints
# this tool uses, but both are unofficial/reverse-engineered integrations
# (see README "Known limitations") and may need adjustment.
