# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.

# Optional. Only needed for the "Add a plant" feature, which asks Claude to
# draft a species profile for a plant not in the built-in list. Without this
# set, "Add a plant" falls back to a blank manual-entry template instead.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Port the local web server listens on. Defaults to 4100.
PORT=4100
